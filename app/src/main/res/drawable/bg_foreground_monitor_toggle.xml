<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <ripple android:color="@color/expressive_primary_20">
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/expressive_primary" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/expressive_primary" />
                </shape>
            </item>
        </ripple>
    </item>

    <item>
        <ripple android:color="@color/expressive_primary_20">
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/expressive_surface_card" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/expressive_outline" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
