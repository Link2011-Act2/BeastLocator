<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/settings"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/expressive_on_surface" />

    <ImageButton
        android:id="@+id/distanceMaskToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/distance_mask_button_content_description_off"
        android:padding="10dp"
        android:src="@drawable/ic_visibility_off"
        app:layout_constraintBottom_toBottomOf="@id/settingsButton"
        app:layout_constraintEnd_toStartOf="@id/settingsButton"
        app:layout_constraintTop_toTopOf="@id/settingsButton"
        app:tint="@color/expressive_on_surface" />

    <LinearLayout
        android:id="@+id/centerContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/arrowView"
            android:layout_width="208dp"
            android:layout_height="208dp"
            android:contentDescription="@string/arrow"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/yjsnpi" />

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:text="@string/waiting_location"
            android:textColor="@color/expressive_on_surface"
            android:textLocale="ja-JP"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/directionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:text="@string/direction_placeholder"
            android:textColor="@color/expressive_on_surface_variant"
            android:textLocale="ja-JP"
            android:textSize="30sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/arrivalContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/arrivalTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:text="@string/arrival_title"
            android:textAlignment="center"
            android:textColor="@color/expressive_on_surface"
            android:textLocale="ja-JP"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arrivalNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:gravity="start"
            android:text="@string/arrival_name_placeholder"
            android:textAlignment="viewStart"
            android:textColor="@color/expressive_on_surface_variant"
            android:textLocale="ja-JP"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arrivalCoordsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/noto_sans_mono"
            android:gravity="start"
            android:text="@string/arrival_coords_placeholder"
            android:textAlignment="viewStart"
            android:textColor="@color/expressive_on_surface_variant"
            android:textLocale="ja-JP"
            android:textSize="14sp" />

        <Button
            android:id="@+id/createNextDestinationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:text="@string/create_next_destination" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/updateBannerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:elevation="10dp"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/expressive_primary_container"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/update_banner_title"
                    android:textColor="@color/expressive_on_primary_container"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/updateBannerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:textColor="@color/expressive_on_primary_container"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/updateBannerDismissButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_update_banner_close"
                android:contentDescription="@string/update_banner_dismiss"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="@color/expressive_on_primary_container" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>

